{
  "name": "sopung-camp-manager",
  "version": "0.1.16",
  "private": true,
  "description": "소풍캠핑장 자리 배정과 예약 관리",
  "author": "Sopung Camp",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:desktop": "node tests/desktop.cjs && node tests/desktop-camfit.cjs",
    "test:camfit-desktop": "node tests/desktop-camfit.cjs",
    "format": "prettier --write src electron tests package.json tsconfig.json vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src electron tests package.json tsconfig.json vite.config.ts playwright.config.ts",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --ia32 --publish never"
  },
  "build": {
    "appId": "kr.sopung.camp.manager",
    "productName": "Sopung Camp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "electronLanguages": [
      "ko",
      "en-US"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Sopung-Camp-Setup-${version}.${ext}",
      "shortcutName": "소풍캠핑장",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ]
    }
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.1.23",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "22.3.27",
    "electron-builder": "26.15.3",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
